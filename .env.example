PORT=3000
NODE_ENV=development
# 生产环境请使用 openssl rand -hex 32 生成，长度不得小于 32 个字符
JWT_SECRET=dev-only-change-this-to-a-strong-random-string-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# 命令执行配置
USE_SUDO=false

# 默认管理员（首次初始化）
# 生产环境请在 .env 中设置为强密码，长度不得小于 8 位，且禁止 admin / admin123
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# SQLite 数据库路径（相对于项目根目录）
DB_PATH=./data/panel.db
